          "description": "Background color."
        },
        "barWidth": {
          "default": 10,
          "description": "The width of a bar display, in columns.",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "bold": {
          "description": "Bold text.",
          "type": "boolean"
        },
        "character": {
          "description": "The text of a separator, or an icon before the git-branch name.",
          "type": "string"
        },
        "color": {
          "$ref": "#/definitions/color",
          "description": "Foreground color, in place of the widget's default."
        },
        "commandPath": {
          "description": "The shell command of a custom-command widget, run with sh -c and given Claude Code's JSON on stdin. The first line of its output is shown.",
          "type": "string"
        },
        "customText": {
          "description": "The text of a custom-text widget.",
          "type": "string"
        },
        "display": {
          "description": "One of the widget's display modes.",
          "type": "string"
        },
        "maxWidth": {
          "description": "Cap the widget's text at this many columns, ending it with an ellipsis. The prefix and suffix are not counted.",
          "minimum": 0,
          "type": "integer"
        },
        "merge": {
          "description": "Join this widget to the next one without defaultPadding.",
          "type": "boolean"
        },
        "prefix": {
          "description": "Text before the widget's output, in place of the widget's default prefix such as \"Ctx: \". An empty string removes the default.",
          "type": "string"
        },
        "preserveColors": {
          "description": "Keep the ANSI colors in custom-command output.",
          "type": "boolean"
        },
        "rawValue": {
          "description": "Use the widget's raw mode, on widgets that have one.",
          "type": "boolean"
        },
        "suffix": {
          "description": "Text after the widget's output.",
          "type": "string"
        },
        "thresholds": {
          "description": "Restyle a numeric widget by its value. The highest gte reached wins; below the first, the item's own colors apply.",
          "items": {
            "$ref": "#/definitions/threshold"
          },
          "type": "array"
        },
        "timeout": {
          "default": 3000,
          "description": "The custom-command timeout in milliseconds. When it expires, the command and everything it started are killed.",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "The widget to render.",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    }
  },
  "description": "Settings of ccstatus, the status line formatter for Claude Code. Fields left out keep their defaults.",
  "properties": {
    "$schema": {
      "description": "The JSON Schema this file follows, which lets an editor complete and check it.",
      "type": "string"
    },
    "colorLevel": {
      "default": 2,
      "description": "0 disables color. 1 emits the 16 ANSI colors, 2 the 256-color palette, 3 true color; a color the level cannot express is mapped to the nearest one it can.",
      "enum": [
        0,
        1,
        2,
        3
      ],
      "type": "integer"
    },
    "compactThreshold": {
      "default": 90,
      "description": "The context percentage at which full-until-compact switches to the 40-column margin.",
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
    },
    "defaultPadding": {
      "default": " ",
      "description": "Inserted between adjacent widgets, separators included, except after an item with merge.",
      "type": "string"
    },
    "defaultSeparator": {
      "default": "|",
      "description": "The text a separator shows unless it sets character.",
      "type": "string"
    },
    "flexMode": {
      "default": "full-until-compact",
      "description": "The right margin each row leaves: where the row is cut with \"...\" and how far a flex-separator fills.",
      "enum": [
        "full",
        "full-minus-40",
        "full-until-compact",
        "exact"
      ],
      "enumDescriptions": [
        "The terminal width minus 10 columns.",
        "The terminal width minus 40 columns.",
        "Minus 10 columns, then minus 40 once the context percentage reaches compactThreshold.",
        "The terminal width, with no margin: for Claude Code's fullscreen rendering, where notifications get a row of their own."
      ],
      "type": "string"
    },
    "globalBold": {
