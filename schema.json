    "color": {
      "anyOf": [
        {
          "enum": [
            "black",
            "red",
            "green",
            "yellow",
            "blue",
            "magenta",
            "cyan",
            "white",
            "brightBlack",
            "brightRed",
            "brightGreen",
            "brightYellow",
            "brightBlue",
            "brightMagenta",
            "brightCyan",
            "brightWhite"
          ]
        },
        {
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
          "type": "string"
        },
        {
          "pattern": "^(\\d|[1-9]\\d|1\\d{2}|2[0-4]\\d|25[0-5])$",
          "type": "string"
        }
      ],
      "description": "A color: one of the 16 ANSI color names, a hex triplet such as \"#ff8700\", or a 256-color palette index \"0\" to \"255\"."
    },
