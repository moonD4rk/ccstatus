                "transcript-path",
                "version",
                "vim-mode"
              ],
              "enumDescriptions": [
                "Directories added via /add-dir. Default color: blue.",
                "Agent name when using --agent flag. Default color: cyan. Default prefix: \"Agent: \".",
                "Total API response time. Default color: white. Default prefix: \"API: \".",
                "Time into the 5-hour rate-limit window. Default color: white. Default prefix: \"Block: \".",
                "Cache creation input token count. Default color: white. Default prefix: \"CacheW: \".",
                "Session prompt cache hit ratio (falls back to the last request's cache reads). Default color: cyan. Default prefix: \"Cache: \".",
                "Context window usage in tokens. Default color: white. Default prefix: \"CtxLen: \".",
                "Context usage as percentage of max window. Default color: white. Default prefix: \"Ctx: \".",
                "Context usage as % of the usable window (heuristic: 80% of max, leaving auto-compact headroom). Default color: white. Default prefix: \"Usable: \".",
                "Current round input token count. Default color: white. Default prefix: \"CurIn: \".",
                "Current round output token count. Default color: white. Default prefix: \"CurOut: \".",
                "Current working directory. Default color: blue.",
                "Output from a shell command. Default color: white.",
                "User-defined static text. Default color: white.",
                "Current reasoning effort level. Default color: cyan. Default prefix: \"Effort: \".",
                "Warning when tokens exceed 200k threshold. Default color: red.",
                "Shows Fast while fast mode is on. Default color: yellow.",
                "Expands to fill remaining terminal width.",
                "Current git branch name. Default color: magenta.",
                "Uncommitted changes count. Default color: yellow.",
                "Current git worktree name. Default color: magenta.",
                "Uncommitted lines added (git diff). Default color: green.",
                "Uncommitted lines added and removed (git diff). Default color: green.",
                "Uncommitted lines removed (git diff). Default color: red.",
                "Current Claude model name. Default color: cyan.",
                "Current output style name. Default color: white. Default prefix: \"Style: \".",
                "Open PR (#N) or GitLab merge request (!N) and review state. Default color: cyan.",
                "Project root directory. Default color: blue.",
                "Prompt cache warm/cold with time left, hit ratio, or misses. Default color: green. Default prefix: \"Cache: \".",
                "5-hour rate-limit usage. Default color: yellow. Default prefix: \"5h limit: \".",
                "7-day rate-limit usage. Default color: yellow. Default prefix: \"7d limit: \".",
                "Combined 5h/7d rate-limit usage and gateway spend limit. Default color: yellow. Default prefix: \"Limit \".",
                "Remaining context window percentage. Default color: white. Default prefix: \"Rem: \".",
                "Repository owner/name from the origin remote, linked to its web page. Default color: blue.",
                "Visual separator between widgets. Default color: white.",
                "Session duration. Default color: white. Default prefix: \"Session: \".",
                "Session cost in USD. Default color: green.",
                "Claude Code session identifier. Default color: white.",
                "Lines Claude added and removed this session. Default color: green.",
                "Session name from --name or /rename, or the AI-generated title. Default color: white.",
                "Claude apps gateway spend against its limit. Default color: yellow. Default prefix: \"Spend: \".",
                "Line width in columns: the terminal width minus the flexMode margin. Default color: white.",
                "Extended thinking indicator. Default color: magenta. Default prefix: \"Think: \".",
                "Cached token count. Default color: white. Default prefix: \"Cached: \".",
                "Input tokens currently in context (includes cache reads/writes). Default color: white. Default prefix: \"In: \".",
                "Output tokens from the most recent API response. Default color: white. Default prefix: \"Out: \".",
                "Total tokens currently in the context window (input + output). Default color: white. Default prefix: \"Total: \".",
                "Transcript file path. Default color: white.",
                "Claude Code version. Default color: white.",
                "Current vim mode indicator. Default color: yellow. Default prefix: \"Vim: \"."
              ]
            }
